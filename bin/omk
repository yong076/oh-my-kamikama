#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"

usage() {
  cat <<'EOF'
Usage:
  omk
  omk "task"
  omk shell [--repo PATH]
  omk run [--repo PATH] "task"
  omk advise [--repo PATH] "task"
  omk bg [--repo PATH] "task"
  omk cockpit [--repo PATH] "task"
  omk watch [--repo PATH] [job-id|latest]
  omk ps [--repo PATH]
  omk logs [--repo PATH] [job-id|latest]
  omk tail [--repo PATH] [job-id|latest]
  omk kill [--repo PATH] <job-id|latest>
  omk tools
  omk status
  omk doctor

What runs:
  claude  Advisor pass, read-only/plan oriented
  gemini  Advisor pass, read-only/plan oriented
  codex   Final executor pass, informed by both advisor artifacts

Options:
  -C, --repo PATH   Target repository/workspace. Defaults to current directory.
  -h, --help        Show help.

Environment:
  OMK_KEEP_GOING=1  Continue to Codex even if an advisor fails.
  OMK_SHELL_MODE    Initial interactive mode: run, advise, bg, or cockpit.
EOF
}

die() {
  echo "omk: $*" >&2
  exit 1
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_cmd() {
  have_cmd "$1" || die "missing required command: $1"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-54
}

now_utc() {
  date -u '+%Y-%m-%dT%H-%M-%SZ'
}

cmd_version() {
  local cmd="$1"
  if ! have_cmd "$cmd"; then
    printf '%-8s missing\n' "$cmd"
    return 0
  fi

  local version
  case "$cmd" in
    claude) version="$("$cmd" --version 2>/dev/null || true)" ;;
    gemini) version="$("$cmd" --version 2>/dev/null || true)" ;;
    codex) version="$("$cmd" --version 2>/dev/null || true)" ;;
    opencode) version="$("$cmd" --version 2>/dev/null || true)" ;;
    omx) version="$("$cmd" --version 2>/dev/null | head -n 1 || true)" ;;
    cmux) version="$("$cmd" version 2>/dev/null || true)" ;;
    *) version="" ;;
  esac

  if [[ -n "$version" ]]; then
    printf '%-8s %s (%s)\n' "$cmd" "$(command -v "$cmd")" "$version"
  else
    printf '%-8s %s\n' "$cmd" "$(command -v "$cmd")"
  fi
}

status() {
  echo "oh-my-kamikama $VERSION"
  echo "======================"
  cmd_version claude
  cmd_version codex
  cmd_version gemini
  cmd_version opencode
  cmd_version omx
  cmd_version cmux
}

tools() {
  status
  echo
  echo "Core pipeline"
  echo "-------------"
  echo "claude  advisor: plan/risk/verification lane"
  echo "gemini  advisor: alternate plan/risk/verification lane"
  echo "codex   executor: final implementation and focused verification"
  echo
  echo "Optional adapters"
  echo "-----------------"
  echo "opencode  scout/reviewer lane via 'opencode run' or cmux omo"
  echo "omx       durable goals/team/HUD lane via 'omx ultragoal' and 'omx team'"
  echo "cmux      pane/surface visibility for long-running background work"
  echo
  echo "Recommended modes"
  echo "-----------------"
  echo "omk advise  cheap-ish interrogation before code"
  echo "omk run     full Claude + Gemini + Codex pipeline"
  echo "omk bg      same pipeline in the background with logs and status"
  echo "omk cockpit cmux workspace with status + runner panes"
}

doctor() {
  status
  echo

  local failed=0
  for cmd in claude codex gemini; do
    if have_cmd "$cmd"; then
      echo "[OK] $cmd found"
    else
      echo "[FAIL] $cmd missing"
      failed=1
    fi
  done

  for cmd in opencode omx cmux; do
    if have_cmd "$cmd"; then
      echo "[OK] $cmd found (optional)"
    else
      echo "[OK] $cmd not installed (optional)"
    fi
  done

  return "$failed"
}

parse_repo_only() {
  repo="$PWD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|-C)
        [[ $# -ge 2 ]] || die "--repo requires a path"
        repo="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        break
        ;;
    esac
  done
  repo="$(cd "$repo" && pwd)"
  extra_args=("$@")
}

parse_repo_and_task() {
  repo="$PWD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|-C)
        [[ $# -ge 2 ]] || die "--repo requires a path"
        repo="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -gt 0 ]] || die "missing task"
  task="$*"
  repo="$(cd "$repo" && pwd)"
}

quote_shell() {
  printf '%q' "$1"
}

json_escape() {
  awk 'BEGIN { ORS = "" } { gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); print }' <<<"$1"
}

trim() {
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' <<<"$1"
}

prepare_run_dir() {
  local repo_path="$1"
  local task_text="$2"
  local base_slug
  base_slug="$(slugify "$task_text")"
  [[ -n "$base_slug" ]] || base_slug="task"

  local root="$repo_path/.omk/runs"
  local dir="$root/$(now_utc)-$base_slug"
  mkdir -p "$dir"
  printf '%s\n' "$task_text" >"$dir/task.txt"
  echo "$dir"
}

advisor_prompt() {
  local provider="$1"
  local repo_path="$2"
  local task_text="$3"

  cat <<EOF
You are the $provider advisor in an oh-my-kamikama run.

Repository:
$repo_path

Task:
$task_text

Return concise markdown with exactly these sections:
- Recommended approach
- Dive questions
- AI-DLC phase and gates
- Risks
- Verification
- What Codex should avoid

Use the divecode genie principle: if the user made a vague wish, surface the
missing constraints before anyone grants it literally. Map the task to
AI-DLC: Inception, Construction, or Operations. Do not edit files. Do not
perform implementation. Keep this advisory.
EOF
}

write_advisor_markdown() {
  local provider="$1"
  local exit_code="$2"
  local stdout_file="$3"
  local stderr_file="$4"
  local target_file="$5"

  {
    echo "# $provider advisor"
    echo
    echo "- Provider: $provider"
    echo "- Exit code: $exit_code"
    echo "- Created: $(now_utc)"
    echo
    echo "## Output"
    echo
    echo '```text'
    cat "$stdout_file" 2>/dev/null || true
    echo '```'
    echo
    echo "## Diagnostics"
    echo
    echo '```text'
    cat "$stderr_file" 2>/dev/null || true
    echo '```'
  } >"$target_file"
}

run_claude_advisor() {
  local repo_path="$1"
  local prompt="$2"
  local stdout_file="$3"
  local stderr_file="$4"

  (
    cd "$repo_path"
    claude --print --permission-mode plan "$prompt"
  ) >"$stdout_file" 2>"$stderr_file"
}

run_gemini_advisor() {
  local repo_path="$1"
  local prompt="$2"
  local stdout_file="$3"
  local stderr_file="$4"

  (
    cd "$repo_path"
    GEMINI_CLI_TRUST_WORKSPACE=true gemini \
      --skip-trust \
      --approval-mode plan \
      --prompt "$prompt"
  ) >"$stdout_file" 2>"$stderr_file"
}

run_advisors() {
  local repo_path="$1"
  local task_text="$2"
  local run_dir="$3"

  require_cmd claude
  require_cmd gemini

  local claude_prompt gemini_prompt
  claude_prompt="$(advisor_prompt claude "$repo_path" "$task_text")"
  gemini_prompt="$(advisor_prompt gemini "$repo_path" "$task_text")"

  run_claude_advisor "$repo_path" "$claude_prompt" "$run_dir/claude.out" "$run_dir/claude.err" &
  local claude_pid=$!
  run_gemini_advisor "$repo_path" "$gemini_prompt" "$run_dir/gemini.out" "$run_dir/gemini.err" &
  local gemini_pid=$!

  local claude_status=0
  local gemini_status=0
  wait "$claude_pid" || claude_status=$?
  wait "$gemini_pid" || gemini_status=$?

  write_advisor_markdown claude "$claude_status" "$run_dir/claude.out" "$run_dir/claude.err" "$run_dir/claude.md"
  write_advisor_markdown gemini "$gemini_status" "$run_dir/gemini.out" "$run_dir/gemini.err" "$run_dir/gemini.md"

  if [[ "$claude_status" -ne 0 || "$gemini_status" -ne 0 ]]; then
    return 1
  fi
}

codex_prompt() {
  local repo_path="$1"
  local task_text="$2"
  local run_dir="$3"

  cat <<EOF
You are the Codex executor in an oh-my-kamikama run.

Repository:
$repo_path

Task:
$task_text

Before implementation, read these advisor artifacts:
- $run_dir/claude.md
- $run_dir/gemini.md

Use the advisors as context, not authority. Preserve unrelated user changes.
Apply the divecode genie principle: when the wish is underspecified, do not
silently invent high-risk requirements. Make reversible progress, record open
questions, and keep the user-facing result coherent. Apply AI-DLC gates:
Inception before broad design, Construction with tests/verification, Operations
with handoff notes when shipping behavior changes. Spend context aggressively
when it improves correctness; token thrift is not the goal of this run.
Finish with a concise summary of changes and verification.
EOF
}

run_codex_executor() {
  local repo_path="$1"
  local prompt="$2"
  local run_dir="$3"

  require_cmd codex
  (
    cd "$repo_path"
    codex exec \
      --skip-git-repo-check \
      -C "$repo_path" \
      -s workspace-write \
      "$prompt"
  ) >"$run_dir/codex.out" 2>"$run_dir/codex.err"
}

write_run_summary() {
  local mode="$1"
  local repo_path="$2"
  local task_text="$3"
  local run_dir="$4"

  {
    echo "# oh-my-kamikama run"
    echo
    echo "- Mode: $mode"
    echo "- Repository: $repo_path"
    echo "- Created: $(now_utc)"
    echo
    echo "## Task"
    echo
    printf '%s\n' "$task_text"
    echo
    echo "## Artifacts"
    echo
    echo "- Claude: $run_dir/claude.md"
    echo "- Gemini: $run_dir/gemini.md"
    if [[ -f "$run_dir/codex.out" || -f "$run_dir/codex.err" ]]; then
      echo "- Codex stdout: $run_dir/codex.out"
      echo "- Codex stderr: $run_dir/codex.err"
    fi
  } >"$run_dir/RUN.md"
}

run_pipeline() {
  local mode="$1"
  shift
  parse_repo_and_task "$@"

  local run_dir
  run_dir="$(prepare_run_dir "$repo" "$task")"

  echo "omk run dir: $run_dir"
  echo "running advisors: claude + gemini"

  local advisor_status=0
  run_advisors "$repo" "$task" "$run_dir" || advisor_status=$?

  write_run_summary "$mode" "$repo" "$task" "$run_dir"

  if [[ "$advisor_status" -ne 0 ]]; then
    echo "one or more advisors failed; see $run_dir" >&2
    if [[ "${OMK_KEEP_GOING:-0}" != "1" || "$mode" == "advise" ]]; then
      echo "advisor artifacts:"
      echo "  $run_dir/claude.md"
      echo "  $run_dir/gemini.md"
      return "$advisor_status"
    fi
  fi

  if [[ "$mode" == "advise" ]]; then
    echo "advisor artifacts:"
    echo "  $run_dir/claude.md"
    echo "  $run_dir/gemini.md"
    return 0
  fi

  local prompt
  prompt="$(codex_prompt "$repo" "$task" "$run_dir")"
  printf '%s\n' "$prompt" >"$run_dir/codex.prompt.md"

  echo "running executor: codex"
  local codex_status=0
  run_codex_executor "$repo" "$prompt" "$run_dir" || codex_status=$?
  write_run_summary "$mode" "$repo" "$task" "$run_dir"

  if [[ -s "$run_dir/codex.out" ]]; then
    cat "$run_dir/codex.out"
  fi
  if [[ "$codex_status" -ne 0 ]]; then
    echo "codex failed; stderr: $run_dir/codex.err" >&2
    return "$codex_status"
  fi

  echo "omk artifacts: $run_dir"
}

bg_root_for_repo() {
  local repo_path="$1"
  echo "$repo_path/.omk/bg"
}

cockpit_root_for_repo() {
  local repo_path="$1"
  echo "$repo_path/.omk/cockpits"
}

resolve_job_dir() {
  local repo_path="$1"
  local token="${2:-latest}"
  local root
  root="$(bg_root_for_repo "$repo_path")"

  [[ -d "$root" ]] || die "no background jobs in $root"

  if [[ "$token" == "latest" ]]; then
    local latest
    latest="$(find "$root" -mindepth 1 -maxdepth 1 -type d | sort | tail -n 1)"
    [[ -n "$latest" ]] || die "no background jobs in $root"
    echo "$latest"
    return 0
  fi

  if [[ -d "$root/$token" ]]; then
    echo "$root/$token"
    return 0
  fi

  local matches
  matches="$(find "$root" -mindepth 1 -maxdepth 1 -type d -name "$token*" | sort || true)"
  local count
  count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"
  [[ "$count" -eq 1 ]] || die "job id '$token' matched $count jobs"
  printf '%s\n' "$matches"
}

job_id_from_dir() {
  basename "$1"
}

bg_run() {
  parse_repo_and_task "$@"

  local root id job_dir self
  root="$(bg_root_for_repo "$repo")"
  id="$(now_utc)-$(slugify "$task")"
  job_dir="$root/$id"
  self="${BASH_SOURCE[0]}"

  mkdir -p "$job_dir"
  printf '%s\n' "$repo" >"$job_dir/repo.txt"
  printf '%s\n' "$task" >"$job_dir/task.txt"
  printf '%s\n' "running" >"$job_dir/status"
  now_utc >"$job_dir/started.txt"

  local self_q repo_q task_q job_dir_q
  self_q="$(printf '%q' "$self")"
  repo_q="$(printf '%q' "$repo")"
  task_q="$(printf '%q' "$task")"
  job_dir_q="$(printf '%q' "$job_dir")"

  cat >"$job_dir/run.sh" <<EOF
#!/usr/bin/env bash
set +e
finish_job() {
  code="\${1:-\$?}"
  if [[ ! -f $job_dir_q/exit_code ]]; then
    printf '%s\n' "\$code" >$job_dir_q/exit_code
    date -u '+%Y-%m-%dT%H-%M-%SZ' >$job_dir_q/finished.txt
    if [[ "\$code" -eq 0 ]]; then
      printf '%s\n' "done" >$job_dir_q/status
    else
      printf '%s\n' "failed" >$job_dir_q/status
    fi
  fi
}
trap 'finish_job \$?' EXIT
trap 'finish_job 143; exit 143' HUP INT TERM

$self_q run --repo $repo_q $task_q >$job_dir_q/stdout.log 2>$job_dir_q/stderr.log
code="\$?"
printf '%s\n' "\$code" >$job_dir_q/exit_code
date -u '+%Y-%m-%dT%H-%M-%SZ' >$job_dir_q/finished.txt
if [[ "\$code" -eq 0 ]]; then
  printf '%s\n' "done" >$job_dir_q/status
else
  printf '%s\n' "failed" >$job_dir_q/status
fi
sed -n 's/^omk artifacts: //p' $job_dir_q/stdout.log | tail -n 1 >$job_dir_q/run_dir.txt
trap - EXIT HUP INT TERM
exit "\$code"
EOF
  chmod +x "$job_dir/run.sh"

  nohup bash "$job_dir/run.sh" >"$job_dir/supervisor.log" 2>&1 &
  printf '%s\n' "$!" >"$job_dir/pid"

  echo "omk bg started"
  echo "id: $id"
  echo "pid: $(cat "$job_dir/pid")"
  echo "job: $job_dir"
  echo "logs: omk logs --repo '$repo' $id"
  echo "tail: omk tail --repo '$repo' $id"
}

ps_jobs() {
  parse_repo_only "$@"
  local root
  root="$(bg_root_for_repo "$repo")"
  if [[ ! -d "$root" ]]; then
    echo "no jobs"
    return 0
  fi

  printf '%-58s %-10s %-8s %s\n' "job" "status" "pid" "task"
  find "$root" -mindepth 1 -maxdepth 1 -type d | sort | while read -r job_dir; do
    local id status pid task
    id="$(job_id_from_dir "$job_dir")"
    status="$(cat "$job_dir/status" 2>/dev/null || echo unknown)"
    pid="$(cat "$job_dir/pid" 2>/dev/null || echo -)"
    task="$(cat "$job_dir/task.txt" 2>/dev/null | head -n 1 || true)"
    if [[ "$status" == "running" && "$pid" != "-" ]] && ! ps -p "$pid" >/dev/null 2>&1; then
      status="lost"
    fi
    printf '%-58s %-10s %-8s %s\n' "$id" "$status" "$pid" "$task"
  done
}

watch_jobs() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local interval="${OMK_WATCH_INTERVAL:-2}"

  while true; do
    clear 2>/dev/null || true
    echo "oh-my-kamikama watch"
    echo "===================="
    echo "repo: $repo"
    echo "time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo

    ps_jobs --repo "$repo" || true
    echo

    local job_dir=""
    if job_dir="$(resolve_job_dir "$repo" "$token" 2>/dev/null)"; then
      echo "# $(job_id_from_dir "$job_dir")"
      echo "status: $(cat "$job_dir/status" 2>/dev/null || echo unknown)"
      echo "pid: $(cat "$job_dir/pid" 2>/dev/null || echo -)"
      if [[ -s "$job_dir/run_dir.txt" ]]; then
        echo "run artifacts: $(cat "$job_dir/run_dir.txt")"
      fi
      echo
      echo "## stdout tail"
      if [[ -f "$job_dir/stdout.log" ]]; then
        tail -n 34 "$job_dir/stdout.log"
      else
        echo "(no stdout yet)"
      fi
      echo
      echo "## stderr tail"
      if [[ -f "$job_dir/stderr.log" ]]; then
        tail -n 18 "$job_dir/stderr.log"
      else
        echo "(no stderr yet)"
      fi
    else
      echo "no selected job yet: $token"
      echo "start one with: omk bg --repo $(quote_shell "$repo") \"task\""
    fi

    sleep "$interval"
  done
}

cockpit_launch() {
  parse_repo_and_task "$@"
  require_cmd cmux

  local root title slug cockpit_dir watch_script control_script
  root="$(cockpit_root_for_repo "$repo")"
  slug="$(slugify "$task")"
  [[ -n "$slug" ]] || slug="task"
  title="omk-${slug:0:34}"
  cockpit_dir="$root/$(now_utc)-$slug"
  watch_script="$cockpit_dir/watch.sh"
  control_script="$cockpit_dir/control.sh"

  mkdir -p "$cockpit_dir"
  printf '%s\n' "$repo" >"$cockpit_dir/repo.txt"
  printf '%s\n' "$task" >"$cockpit_dir/task.txt"

  local repo_q cockpit_dir_q
  repo_q="$(quote_shell "$repo")"
  cockpit_dir_q="$(quote_shell "$cockpit_dir")"

  cat >"$watch_script" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd $repo_q
omk watch --repo $repo_q latest
EOF

  cat >"$control_script" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd $repo_q
echo "OH MY KAMISAMA"
echo "=============="
echo
cat $cockpit_dir_q/task.txt
echo
omk bg --repo $repo_q "\$(cat $cockpit_dir_q/task.txt)" | tee $cockpit_dir_q/bg-start.txt
sleep 1
omk tail --repo $repo_q latest
EOF

  chmod +x "$watch_script" "$control_script"

  local watch_cmd control_cmd layout output
  watch_cmd="bash $(quote_shell "$watch_script")"
  control_cmd="bash $(quote_shell "$control_script")"
  layout='{"direction":"horizontal","split":0.43,"children":[{"pane":{"surfaces":[{"type":"terminal","command":"'"$(json_escape "$watch_cmd")"'"}]}},{"pane":{"surfaces":[{"type":"terminal","command":"'"$(json_escape "$control_cmd")"'"}]}}]}'

  output="$(cmux new-workspace \
    --name "$title" \
    --description "Oh My Kamisama cockpit" \
    --cwd "$repo" \
    --layout "$layout" \
    --focus true)"

  echo "$output"
  echo "omk cockpit: $cockpit_dir"
  echo "watch: $watch_script"
  echo "control: $control_script"
}

logs_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local job_dir
  job_dir="$(resolve_job_dir "$repo" "$token")"
  echo "# $(job_id_from_dir "$job_dir")"
  echo
  echo "status: $(cat "$job_dir/status" 2>/dev/null || echo unknown)"
  echo "pid: $(cat "$job_dir/pid" 2>/dev/null || echo -)"
  echo "repo: $(cat "$job_dir/repo.txt" 2>/dev/null || echo -)"
  echo "task: $(cat "$job_dir/task.txt" 2>/dev/null || echo -)"
  echo
  echo "## stdout"
  cat "$job_dir/stdout.log" 2>/dev/null || true
  echo
  echo "## stderr"
  cat "$job_dir/stderr.log" 2>/dev/null || true
}

tail_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local job_dir
  job_dir="$(resolve_job_dir "$repo" "$token")"
  echo "tailing $(job_id_from_dir "$job_dir")"
  touch "$job_dir/stdout.log" "$job_dir/stderr.log"
  tail -n 80 -f "$job_dir/stdout.log" "$job_dir/stderr.log"
}

kill_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-}"
  [[ -n "$token" ]] || die "missing job id"
  local job_dir pid
  job_dir="$(resolve_job_dir "$repo" "$token")"
  pid="$(cat "$job_dir/pid" 2>/dev/null || true)"
  [[ -n "$pid" ]] || die "job has no pid"
  kill "$pid"
  printf '%s\n' "killed" >"$job_dir/status"
  now_utc >"$job_dir/finished.txt"
  echo "killed $(job_id_from_dir "$job_dir") pid=$pid"
}

shell_help() {
  cat <<'EOF'
oh-my-kamikama interactive shell

Type a natural-language task and press Enter. The current mode decides how it runs.

Slash commands:
  /help                 Show this help
  /exit                 Leave the shell
  /repo [PATH]          Show or change target repository
  /mode [MODE]          Show or set default mode: run, advise, bg, cockpit
  /run TASK             Run one task through Claude + Gemini + Codex
  /advise TASK          Ask advisors only
  /bg TASK              Start a background conductor job
  /cockpit TASK         Open a cmux cockpit for the task
  /ps                   List background jobs for the current repo
  /logs [JOB|latest]    Print job logs
  /tail [JOB|latest]    Follow job logs
  /watch [JOB|latest]   Watch job status and tails
  /kill JOB|latest      Stop a background job
  /tools                Show detected tools
  /status               Show omk and provider versions
  /doctor               Check required and optional CLIs
  /! COMMAND            Run a shell command in the current repo
  /clear                Clear the screen

Examples:
  fix the failing auth test and verify it
  /mode cockpit
  build the admin audit view with tests
  /advise review the safest migration path before coding
EOF
}

shell_run_task() {
  local mode="$1"
  local repo_path="$2"
  local task_text="$3"
  local status=0

  case "$mode" in
    run)
      run_pipeline run --repo "$repo_path" "$task_text" || status=$?
      ;;
    advise)
      run_pipeline advise --repo "$repo_path" "$task_text" || status=$?
      ;;
    bg)
      bg_run --repo "$repo_path" "$task_text" || status=$?
      ;;
    cockpit|cmux)
      cockpit_launch --repo "$repo_path" "$task_text" || status=$?
      ;;
    *)
      echo "unknown mode: $mode" >&2
      status=2
      ;;
  esac

  if [[ "$status" -ne 0 ]]; then
    echo "omk shell: task exited with status $status" >&2
  fi
  return 0
}

interactive_shell() {
  parse_repo_only "$@"

  local shell_repo="$repo"
  local shell_mode="${OMK_SHELL_MODE:-run}"
  case "$shell_mode" in
    run|advise|bg|cockpit|cmux) ;;
    *) shell_mode="run" ;;
  esac

  echo "oh-my-kamikama $VERSION"
  echo "Type /help for commands, /exit to quit."
  echo "repo: $shell_repo"
  echo "mode: $shell_mode"
  echo

  local line trimmed cmd rest prompt_base
  while true; do
    prompt_base="$(basename "$shell_repo")"
    printf 'omk:%s %s> ' "$shell_mode" "$prompt_base"
    if ! IFS= read -r line; then
      echo
      break
    fi

    trimmed="$(trim "$line")"
    [[ -n "$trimmed" ]] || continue

    if [[ "$trimmed" == /* ]]; then
      cmd="${trimmed%%[[:space:]]*}"
      rest="$trimmed"
      if [[ "$rest" == "$cmd" ]]; then
        rest=""
      else
        rest="$(trim "${trimmed#"$cmd"}")"
      fi

      case "$cmd" in
        /help|/?)
          shell_help
          ;;
        /exit|/quit)
          break
          ;;
        /repo)
          if [[ -z "$rest" ]]; then
            echo "$shell_repo"
          else
            local next_repo
            if next_repo="$(cd "$rest" && pwd)"; then
              shell_repo="$next_repo"
              echo "repo: $shell_repo"
            else
              echo "repo not found: $rest" >&2
            fi
          fi
          ;;
        /mode)
          if [[ -z "$rest" ]]; then
            echo "$shell_mode"
          else
            case "$rest" in
              run|advise|bg|cockpit|cmux)
                shell_mode="$rest"
                echo "mode: $shell_mode"
                ;;
              *)
                echo "unknown mode: $rest" >&2
                echo "valid modes: run, advise, bg, cockpit" >&2
                ;;
            esac
          fi
          ;;
        /run)
          [[ -n "$rest" ]] || { echo "usage: /run TASK" >&2; continue; }
          shell_run_task run "$shell_repo" "$rest"
          ;;
        /advise)
          [[ -n "$rest" ]] || { echo "usage: /advise TASK" >&2; continue; }
          shell_run_task advise "$shell_repo" "$rest"
          ;;
        /bg)
          [[ -n "$rest" ]] || { echo "usage: /bg TASK" >&2; continue; }
          shell_run_task bg "$shell_repo" "$rest"
          ;;
        /cockpit|/cmux)
          [[ -n "$rest" ]] || { echo "usage: /cockpit TASK" >&2; continue; }
          shell_run_task cockpit "$shell_repo" "$rest"
          ;;
        /ps)
          ps_jobs --repo "$shell_repo" || true
          ;;
        /logs)
          logs_job --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /tail)
          tail_job --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /watch)
          watch_jobs --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /kill)
          [[ -n "$rest" ]] || { echo "usage: /kill JOB|latest" >&2; continue; }
          kill_job --repo "$shell_repo" "$rest" || true
          ;;
        /tools)
          tools
          ;;
        /status)
          status
          ;;
        /doctor)
          doctor || true
          ;;
        /clear)
          clear 2>/dev/null || true
          ;;
        /!)
          [[ -n "$rest" ]] || { echo "usage: /! COMMAND" >&2; continue; }
          (cd "$shell_repo" && bash -lc "$rest") || true
          ;;
        /!*)
          rest="$(trim "${trimmed#/!}")"
          [[ -n "$rest" ]] || { echo "usage: /! COMMAND" >&2; continue; }
          (cd "$shell_repo" && bash -lc "$rest") || true
          ;;
        *)
          echo "unknown command: $cmd" >&2
          echo "type /help for commands" >&2
          ;;
      esac
    else
      shell_run_task "$shell_mode" "$shell_repo" "$trimmed"
    fi
  done
}

main() {
  [[ $# -gt 0 ]] || {
    if [[ -t 0 && -t 1 ]]; then
      interactive_shell
    else
      usage
    fi
    exit 0
  }

  case "$1" in
    shell|repl|interactive)
      shift
      interactive_shell "$@"
      ;;
    run)
      shift
      run_pipeline run "$@"
      ;;
    advise)
      shift
      run_pipeline advise "$@"
      ;;
    bg)
      shift
      bg_run "$@"
      ;;
    cockpit|cmux)
      shift
      cockpit_launch "$@"
      ;;
    watch)
      shift
      watch_jobs "$@"
      ;;
    ps)
      shift
      ps_jobs "$@"
      ;;
    logs)
      shift
      logs_job "$@"
      ;;
    tail)
      shift
      tail_job "$@"
      ;;
    kill)
      shift
      kill_job "$@"
      ;;
    tools)
      shift
      tools "$@"
      ;;
    status)
      shift
      status "$@"
      ;;
    doctor)
      shift
      doctor "$@"
      ;;
    help|--help|-h)
      usage
      ;;
    --version|-v)
      echo "$VERSION"
      ;;
    *)
      run_pipeline run "$@"
      ;;
  esac
}

main "$@"
