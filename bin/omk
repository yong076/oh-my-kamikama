#!/usr/bin/env bash
set -euo pipefail

VERSION="0.8.0"

usage() {
  cat <<'EOF'
Usage:
  omk
  omk "task"
  omk shell [--repo PATH]
  omk auto [--repo PATH] "task"
  omk conduct [--repo PATH] "task"
  omk resume [--repo PATH] [run-id|latest]
  omk run [--repo PATH] "task"
  omk claude [--repo PATH] "task"
  omk gemini [--repo PATH] "task"
  omk advise [--repo PATH] "task"
  omk bg [--repo PATH] "task"
  omk cockpit [--repo PATH] "task"
  omk agents
  omk connect
  omk context [--repo PATH]
  omk diff [--repo PATH]
  omk cost
  omk tasks [--repo PATH]
  omk task [--repo PATH] <add|done|list> [...]
  omk watch [--repo PATH] [job-id|latest]
  omk ps [--repo PATH]
  omk logs [--repo PATH] [job-id|latest]
  omk tail [--repo PATH] [job-id|latest]
  omk kill [--repo PATH] <job-id|latest>
  omk tools
  omk status
  omk doctor

What runs:
  claude  Advisor pass, read-only/plan oriented
  gemini  Advisor pass, read-only/plan oriented
  codex   Final executor pass, informed by both advisor artifacts

Options:
  -C, --repo PATH   Target repository/workspace. Defaults to current directory.
  -h, --help        Show help.

Environment:
  OMK_KEEP_GOING=1  Continue to Codex even if an advisor fails.
  OMK_SHELL_MODE    Initial interactive mode: auto, run, claude, gemini,
                    advise, bg, cockpit, or cmux.
  OMK_SKIP_AGENTCAT_INSTALL=1
                    Do not auto-install Agent Cat Connectors.
EOF
}

die() {
  echo "omk: $*" >&2
  exit 1
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

require_cmd() {
  have_cmd "$1" || die "missing required command: $1"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-54
}

now_utc() {
  date -u '+%Y-%m-%dT%H-%M-%SZ'
}

cmd_version() {
  local cmd="$1"
  if ! have_cmd "$cmd"; then
    printf '%-8s missing\n' "$cmd"
    return 0
  fi

  local version
  case "$cmd" in
    claude) version="$("$cmd" --version 2>/dev/null || true)" ;;
    gemini) version="$("$cmd" --version 2>/dev/null || true)" ;;
    codex) version="$("$cmd" --version 2>/dev/null || true)" ;;
    opencode) version="$("$cmd" --version 2>/dev/null || true)" ;;
    omx) version="$("$cmd" --version 2>/dev/null | head -n 1 || true)" ;;
    cmux) version="$("$cmd" version 2>/dev/null || true)" ;;
    agentcat) version="$("$cmd" version 2>/dev/null || true)" ;;
    *) version="" ;;
  esac

  if [[ -n "$version" ]]; then
    printf '%-8s %s (%s)\n' "$cmd" "$(command -v "$cmd")" "$version"
  else
    printf '%-8s %s\n' "$cmd" "$(command -v "$cmd")"
  fi
}

status() {
  echo "oh-my-kamisama $VERSION"
  echo "======================"
  cmd_version claude
  cmd_version codex
  cmd_version gemini
  cmd_version opencode
  cmd_version omx
  cmd_version cmux
  cmd_version agentcat
}

tools() {
  status
  echo
  echo "Core pipeline"
  echo "-------------"
  echo "claude  advisor: plan/risk/verification lane"
  echo "gemini  advisor: alternate plan/risk/verification lane"
  echo "codex   executor: final implementation and focused verification"
  echo
  echo "Optional adapters"
  echo "-----------------"
  echo "opencode  scout/reviewer lane via 'opencode run' or cmux omo"
  echo "omx       durable goals/team/HUD lane via 'omx ultragoal' and 'omx team'"
  echo "cmux      pane/surface visibility for long-running background work"
  echo "agentcat  local usage/quota/activity snapshots for auto routing"
  echo
  echo "Recommended modes"
  echo "-----------------"
  echo "omk advise  cheap-ish interrogation before code"
  echo "omk auto    pick the best available executor from Agent Cat usage"
  echo "omk run     full Claude + Gemini + Codex pipeline"
  echo "omk claude  direct Claude Code executor"
  echo "omk gemini  direct Gemini executor with fallback confirmation"
  echo "omk bg      same pipeline in the background with logs and status"
  echo "omk cockpit cmux workspace with status + runner panes"
}

doctor() {
  status
  echo

  local failed=0
  for cmd in claude codex gemini; do
    if have_cmd "$cmd"; then
      echo "[OK] $cmd found"
    else
      echo "[FAIL] $cmd missing"
      failed=1
    fi
  done

  for cmd in opencode omx cmux agentcat; do
    if have_cmd "$cmd"; then
      echo "[OK] $cmd found (optional)"
    else
      echo "[OK] $cmd not installed (optional)"
    fi
  done

  return "$failed"
}

parse_repo_only() {
  repo="$PWD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|-C)
        [[ $# -ge 2 ]] || die "--repo requires a path"
        repo="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        break
        ;;
    esac
  done
  repo="$(cd "$repo" && pwd)"
  extra_args=("$@")
}

parse_repo_and_task() {
  repo="$PWD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|-C)
        [[ $# -ge 2 ]] || die "--repo requires a path"
        repo="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -gt 0 ]] || die "missing task"
  task="$*"
  repo="$(cd "$repo" && pwd)"
}

quote_shell() {
  printf '%q' "$1"
}

json_escape() {
  awk 'BEGIN { ORS = "" } { gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); print }' <<<"$1"
}

trim() {
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' <<<"$1"
}

omk_script_dir() {
  local source dir target
  source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)" || return 1
    target="$(readlink "$source")" || return 1
    if [[ "$target" == /* ]]; then
      source="$target"
    else
      source="$dir/$target"
    fi
  done
  cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd
}

agentcat_install_script() {
  local here candidate
  here="$(omk_script_dir || true)"
  for candidate in \
    "$here/../scripts/install-agentcat-connectors.sh" \
    "$PWD/scripts/install-agentcat-connectors.sh" \
    "$HOME/Trappist/oh-my-kamikama/scripts/install-agentcat-connectors.sh" \
    "$HOME/Trappist/oh-my-kamisama/scripts/install-agentcat-connectors.sh"; do
    if [[ -x "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

ensure_agentcat_connectors() {
  if [[ "${OMK_SKIP_AGENTCAT_INSTALL:-0}" == "1" ]]; then
    return 0
  fi
  if have_cmd agentcat; then
    return 0
  fi

  echo "omk: installing Agent Cat Connectors for usage/quota snapshots..." >&2
  local installer
  if installer="$(agentcat_install_script 2>/dev/null)"; then
    bash "$installer" || return 1
  elif [[ -x "$HOME/Trappist/agentcat-connectors/install.sh" ]]; then
    bash "$HOME/Trappist/agentcat-connectors/install.sh" || return 1
  else
    curl -fsSL https://raw.githubusercontent.com/yong076/agentcat-connectors/main/install.sh | bash || return 1
  fi
}

agentcat_snapshot_json() {
  if have_cmd agentcat; then
    agentcat snapshot --json 2>/dev/null && return 0
  fi
  if [[ -f "$HOME/.agentcat/latest-snapshot.json" ]]; then
    cat "$HOME/.agentcat/latest-snapshot.json"
    return 0
  fi
  return 1
}

agentcat_status_table() {
  local snapshot
  snapshot="$(agentcat_snapshot_json 2>/dev/null || true)"
  if [[ -z "$snapshot" ]]; then
    echo "Agent Cat: unavailable (run: omk connect)"
    return 0
  fi

  SNAPSHOT_JSON="$snapshot" python3 - <<'PY'
import json
import os
import shutil
import sys

try:
    snap = json.loads(os.environ.get("SNAPSHOT_JSON", "{}"))
except Exception:
    print("Agent Cat: snapshot parse failed")
    sys.exit(0)

providers = snap.get("providers") or {}
activity = snap.get("activity") or {}
counts = activity.get("countsByProvider") or {}
memory = activity.get("memoryBytesByProvider") or {}
processes = activity.get("processes") or []

cpu = {}
for proc in processes:
    provider = proc.get("provider")
    if not provider:
        continue
    try:
        cpu[provider] = cpu.get(provider, 0.0) + float(proc.get("cpuPercent") or proc.get("cpu") or 0.0)
    except Exception:
        pass

def fmt_pct(value):
    if value is None:
        return "unknown"
    try:
        return f"{float(value):.1f}%"
    except Exception:
        return "unknown"

def fmt_int(value):
    try:
        value = int(value or 0)
    except Exception:
        value = 0
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.1f}B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}K"
    return str(value)

def fmt_mem(value):
    try:
        value = int(value or 0)
    except Exception:
        value = 0
    if value <= 0:
        return "-"
    if value >= 1024 ** 3:
        return f"{value / (1024 ** 3):.1f}G"
    return f"{value / (1024 ** 2):.0f}M"

def quota_summary(provider):
    limits = (providers.get(provider) or {}).get("limits") or {}
    quotas = limits.get("quotas") or []
    best = None
    for quota in quotas:
        remaining = quota.get("remainingPercent")
        if remaining is None and quota.get("usedPercent") is not None:
            try:
                remaining = 100.0 - float(quota.get("usedPercent"))
            except Exception:
                remaining = None
        if remaining is None:
            continue
        try:
            remaining = float(remaining)
        except Exception:
            continue
        if best is None or remaining < best[0]:
            best = (remaining, quota)
    if best is None:
        return "unknown", None
    label = best[1].get("label") or best[1].get("window") or "quota"
    return f"{best[0]:.1f}% {label}", best[0]

def route_score(provider):
    cli = shutil.which(provider if provider != "claude" else "claude")
    pdata = providers.get(provider) or {}
    status = pdata.get("status") or "missing"
    quota_text, remaining = quota_summary(provider)
    if not cli or status not in ("ok", "partial", "unknown"):
        return -1
    if remaining is None:
        return 50
    return remaining

print("Agents")
print("------")
print(f"{'agent':<8} {'cli':<7} {'state':<10} {'quota-left':<18} {'week':<8} {'proc':<5} {'cpu':<7} {'mem':<7}")
for provider in ("codex", "claude", "gemini"):
    pdata = providers.get(provider) or {}
    cli = "yes" if shutil.which(provider) else "no"
    state = pdata.get("status") or "missing"
    quota_text, _ = quota_summary(provider)
    week = fmt_int((pdata.get("tokens") or {}).get("week"))
    proc_count = counts.get(provider, 0)
    cpu_text = f"{cpu.get(provider, 0.0):.1f}%"
    mem_text = fmt_mem(memory.get(provider))
    print(f"{provider:<8} {cli:<7} {state:<10} {quota_text:<18} {week:<8} {proc_count!s:<5} {cpu_text:<7} {mem_text:<7}")

non_gemini = [(route_score(p), p) for p in ("codex", "claude") if route_score(p) >= 0]
if non_gemini:
    score, route = sorted(non_gemini, reverse=True)[0]
elif route_score("gemini") >= 0:
    score, route = route_score("gemini"), "gemini"
else:
    score, route = -1, "none"

activity_text = activity.get("motionStage") or "unknown"
print()
print(f"activity: {activity_text} | suggested: {route}" + (f" ({score:.1f})" if score >= 0 else ""))
PY
}

agentcat_status_compact() {
  local snapshot
  snapshot="$(agentcat_snapshot_json 2>/dev/null || true)"
  if [[ -z "$snapshot" ]]; then
    echo "agents: Agent Cat unavailable (run /connect)"
    echo "route: $(agentcat_route_choice 2>/dev/null || echo unknown)"
    return 0
  fi

  SNAPSHOT_JSON="$snapshot" python3 - <<'PY'
import json
import os
import shutil

try:
    snap = json.loads(os.environ.get("SNAPSHOT_JSON", "{}"))
except Exception:
    print("agents: snapshot parse failed")
    print("route: unknown")
    raise SystemExit(0)

providers = snap.get("providers") or {}
activity = snap.get("activity") or {}

def quota(provider):
    pdata = providers.get(provider) or {}
    limits = pdata.get("limits") or {}
    best = None
    for item in limits.get("quotas") or []:
        value = item.get("remainingPercent")
        if value is None and item.get("usedPercent") is not None:
            try:
                value = 100.0 - float(item.get("usedPercent"))
            except Exception:
                value = None
        if value is None:
            continue
        try:
            value = float(value)
        except Exception:
            continue
        if best is None or value < best[0]:
            best = (value, item)
    if best is None:
        return "unknown", None
    label = best[1].get("label") or best[1].get("window") or "quota"
    return f"{best[0]:.0f}% {label}", best[0]

def score(provider):
    if not shutil.which(provider):
        return -1.0
    status = (providers.get(provider) or {}).get("status") or "unknown"
    if status not in ("ok", "partial", "unknown"):
        return -1.0
    _, value = quota(provider)
    return 50.0 if value is None else value

parts = []
for name, label in (("codex", "Codex"), ("claude", "Claude"), ("gemini", "Gemini")):
    cli = "ok" if shutil.which(name) else "missing"
    q, _ = quota(name)
    parts.append(f"{label} {q} {cli}")

primary = [(score(p), p) for p in ("codex", "claude") if score(p) >= 0]
if primary:
    route = sorted(primary, reverse=True)[0][1]
elif score("gemini") >= 0:
    route = "gemini"
else:
    route = "none"

motion = activity.get("motionStage") or "unknown"
print("agents: " + " | ".join(parts))
print(f"route: {route} | activity: {motion}")
PY
}

short_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    echo "~"
  elif [[ "$path" == "$HOME/"* ]]; then
    echo "~/${path#"$HOME/"}"
  else
    echo "$path"
  fi
}

terminal_columns() {
  local cols
  cols="$(tput cols 2>/dev/null || true)"
  if [[ -z "$cols" || "$cols" -lt 50 ]]; then
    cols=72
  fi
  if [[ "$cols" -gt 96 ]]; then
    cols=96
  fi
  echo "$cols"
}

rule_line() {
  local cols char
  cols="$(terminal_columns)"
  char="${1:--}"
  printf '%*s\n' "$cols" '' | tr ' ' "$char"
}

shell_prompt_glyph() {
  if [[ "${OMK_ASCII:-0}" == "1" ]]; then
    echo ">"
  else
    echo "🐱"
  fi
}

shell_banner() {
  local shell_repo="$1"
  local shell_mode="$2"
  local route repo_short
  route="$(agentcat_route_choice 2>/dev/null || echo unknown)"
  repo_short="$(short_path "$shell_repo")"

  echo "🐱  Oh My Kamisama v$VERSION"
  echo "repo:  $repo_short"
  echo "mode:  $shell_mode"
  echo "route: $route"
  rule_line "-"
  agentcat_status_compact
  rule_line "-"
  echo "try:   describe a task, /mode cockpit, /advise <question>"
  echo "keys:  Enter run, /screen status panel, /exit quit"
  echo "type a task, /agents for detail, /context for repo, /exit to quit"
}

agentcat_route_choice() {
  local snapshot
  snapshot="$(agentcat_snapshot_json 2>/dev/null || true)"
  if [[ -z "$snapshot" ]]; then
    if have_cmd codex; then
      echo codex
    elif have_cmd claude; then
      echo claude
    elif have_cmd gemini; then
      echo gemini
    else
      echo none
    fi
    return 0
  fi

  SNAPSHOT_JSON="$snapshot" python3 - <<'PY'
import json
import os
import shutil

try:
    snap = json.loads(os.environ.get("SNAPSHOT_JSON", "{}"))
except Exception:
    snap = {}
providers = snap.get("providers") or {}

def quota_remaining(provider):
    limits = (providers.get(provider) or {}).get("limits") or {}
    values = []
    for quota in limits.get("quotas") or []:
        value = quota.get("remainingPercent")
        if value is None and quota.get("usedPercent") is not None:
            try:
                value = 100.0 - float(quota.get("usedPercent"))
            except Exception:
                value = None
        if value is None:
            continue
        try:
            values.append(float(value))
        except Exception:
            pass
    return min(values) if values else None

def score(provider):
    if not shutil.which(provider):
        return -1
    status = (providers.get(provider) or {}).get("status") or "unknown"
    if status not in ("ok", "partial", "unknown"):
        return -1
    remaining = quota_remaining(provider)
    if remaining is None:
        return 50.0
    return remaining

primary = [(score(p), p) for p in ("codex", "claude") if score(p) >= 0]
if primary:
    print(sorted(primary, reverse=True)[0][1])
elif score("gemini") >= 0:
    print("gemini")
else:
    print("none")
PY
}

agentcat_cost_report() {
  local snapshot
  snapshot="$(agentcat_snapshot_json 2>/dev/null || true)"
  if [[ -z "$snapshot" ]]; then
    echo "Usage: unavailable (run: omk connect)"
    return 0
  fi

  SNAPSHOT_JSON="$snapshot" python3 - <<'PY'
import json
import os

try:
    snap = json.loads(os.environ.get("SNAPSHOT_JSON", "{}"))
except Exception:
    print("Usage: snapshot parse failed")
    raise SystemExit(0)

insights = snap.get("insights") or {}
summary = insights.get("summary") or {}
providers = snap.get("providers") or {}

def fmt_int(value):
    try:
        value = int(value or 0)
    except Exception:
        value = 0
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.1f}B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}K"
    return str(value)

print("Usage")
print("-----")
if summary:
    if summary.get("top_provider"):
        print(f"top provider: {summary.get('top_provider')}")
    if summary.get("top_model"):
        print(f"top model: {summary.get('top_model')}")
    if summary.get("total_tokens") is not None:
        print(f"total tokens: {fmt_int(summary.get('total_tokens'))}")
    if summary.get("estimated_cost_usd") is not None:
        print(f"estimated cost: ${float(summary.get('estimated_cost_usd') or 0):.2f}")
    if summary.get("cache_hit_percent") is not None:
        print(f"cache hit: {float(summary.get('cache_hit_percent') or 0):.1f}%")
else:
    print(f"insights: {insights.get('status') or 'unavailable'}")

print()
print(f"{'provider':<8} {'today':<10} {'week':<10} {'month':<10} {'status':<10}")
for provider in ("codex", "claude", "gemini"):
    pdata = providers.get(provider) or {}
    tokens = pdata.get("tokens") or {}
    print(
        f"{provider:<8} "
        f"{fmt_int(tokens.get('today')):<10} "
        f"{fmt_int(tokens.get('week')):<10} "
        f"{fmt_int(tokens.get('month')):<10} "
        f"{(pdata.get('status') or 'missing'):<10}"
    )
PY
}

repo_context() {
  parse_repo_only "$@"

  echo "Repository Context"
  echo "=================="
  echo "repo: $repo"
  echo "route: $(agentcat_route_choice 2>/dev/null || echo unknown)"
  echo

  if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local branch root dirty
    branch="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
    root="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)"
    dirty="$(git -C "$repo" status --short 2>/dev/null | wc -l | tr -d ' ')"
    echo "git: yes"
    echo "branch: ${branch:-detached}"
    echo "root: ${root:-$repo}"
    echo "changed files: $dirty"
  else
    echo "git: no"
  fi

  echo
  echo "Files"
  echo "-----"
  find "$repo" \
    -path "$repo/.git" -prune -o \
    -path "$repo/.omk" -prune -o \
    -path "$repo/node_modules" -prune -o \
    -type f -print 2>/dev/null \
    | wc -l \
    | awk '{ print "tracked-ish files: " $1 }'

  echo
  echo "Detected Surfaces"
  echo "-----------------"
  [[ -f "$repo/package.json" ]] && echo "node: package.json"
  [[ -f "$repo/Cargo.toml" ]] && echo "rust: Cargo.toml"
  [[ -f "$repo/pyproject.toml" ]] && echo "python: pyproject.toml"
  [[ -f "$repo/Package.swift" ]] && echo "swift: Package.swift"
  [[ -f "$repo/project.yml" ]] && echo "xcodegen: project.yml"
  [[ -f "$repo/README.md" ]] && echo "docs: README.md"
  [[ -d "$repo/tests" ]] && echo "tests: tests/"

  if [[ -f "$repo/package.json" ]]; then
    echo
    echo "npm scripts"
    echo "-----------"
    python3 - "$repo/package.json" <<'PY' 2>/dev/null || true
import json
import sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit
scripts = data.get("scripts") or {}
for key in sorted(scripts):
    print(f"{key}: {scripts[key]}")
PY
  fi
}

repo_diff() {
  parse_repo_only "$@"

  echo "Git Diff"
  echo "========"
  echo "repo: $repo"
  echo

  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "not a git repository"
    return 0
  fi

  echo "status"
  echo "------"
  git -C "$repo" status --short
  echo
  echo "diff stat"
  echo "---------"
  git -C "$repo" diff --stat || true
  echo
  echo "staged diff stat"
  echo "----------------"
  git -C "$repo" diff --cached --stat || true
}

tasks_file_for_repo() {
  local repo_path="$1"
  echo "$repo_path/.omk/tasks.tsv"
}

tasks_list() {
  parse_repo_only "$@"
  local file
  file="$(tasks_file_for_repo "$repo")"
  if [[ ! -f "$file" ]]; then
    echo "no tasks"
    return 0
  fi
  printf '%-4s %-10s %-20s %s\n' "id" "status" "created" "task"
  awk -F '\t' '{ printf "%-4s %-10s %-20s %s\n", $1, $2, $3, $4 }' "$file"
}

task_command() {
  parse_repo_only "$@"
  local action="${extra_args[0]:-list}"
  local file id task_text tmp
  file="$(tasks_file_for_repo "$repo")"
  mkdir -p "$(dirname "$file")"

  case "$action" in
    list|ls)
      tasks_list --repo "$repo"
      ;;
    add)
      local task_parts=("${extra_args[@]:1}")
      task_text="${task_parts[*]:-}"
      task_text="$(trim "$task_text")"
      [[ -n "$task_text" ]] || die "usage: omk task --repo PATH add TASK"
      if [[ -f "$file" ]]; then
        id="$(awk -F '\t' 'BEGIN { max=0 } { if ($1+0 > max) max=$1+0 } END { print max+1 }' "$file")"
      else
        id="1"
      fi
      printf '%s\t%s\t%s\t%s\n' "$id" "open" "$(now_utc)" "$task_text" >>"$file"
      echo "task added: $id"
      ;;
    done|close)
      id="${extra_args[1]:-}"
      [[ -n "$id" ]] || die "usage: omk task --repo PATH done ID"
      [[ -f "$file" ]] || die "no tasks"
      tmp="$file.tmp"
      awk -F '\t' -v OFS='\t' -v id="$id" '{ if ($1 == id) $2="done"; print }' "$file" >"$tmp"
      mv "$tmp" "$file"
      echo "task done: $id"
      ;;
    *)
      die "unknown task action: $action"
      ;;
  esac
}

prepare_run_dir() {
  local repo_path="$1"
  local task_text="$2"
  local base_slug
  base_slug="$(slugify "$task_text")"
  [[ -n "$base_slug" ]] || base_slug="task"

  local root="$repo_path/.omk/runs"
  local dir="$root/$(now_utc)-$base_slug"
  mkdir -p "$dir"
  printf '%s\n' "$task_text" >"$dir/task.txt"
  echo "$dir"
}

advisor_prompt() {
  local provider="$1"
  local repo_path="$2"
  local task_text="$3"

  cat <<EOF
You are the $provider advisor in an oh-my-kamisama run.

Repository:
$repo_path

Task:
$task_text

Return concise markdown with exactly these sections:
- Recommended approach
- Dive questions
- AI-DLC phase and gates
- Risks
- Verification
- What Codex should avoid

Use the divecode genie principle: if the user made a vague wish, surface the
missing constraints before anyone grants it literally. Map the task to
AI-DLC: Inception, Construction, or Operations. Do not edit files. Do not
perform implementation. Keep this advisory.
EOF
}

write_advisor_markdown() {
  local provider="$1"
  local exit_code="$2"
  local stdout_file="$3"
  local stderr_file="$4"
  local target_file="$5"

  {
    echo "# $provider advisor"
    echo
    echo "- Provider: $provider"
    echo "- Exit code: $exit_code"
    echo "- Created: $(now_utc)"
    echo
    echo "## Output"
    echo
    echo '```text'
    cat "$stdout_file" 2>/dev/null || true
    echo '```'
    echo
    echo "## Diagnostics"
    echo
    echo '```text'
    cat "$stderr_file" 2>/dev/null || true
    echo '```'
  } >"$target_file"
}

run_claude_advisor() {
  local repo_path="$1"
  local prompt="$2"
  local stdout_file="$3"
  local stderr_file="$4"

  (
    cd "$repo_path"
    claude --print --permission-mode plan "$prompt"
  ) >"$stdout_file" 2>"$stderr_file"
}

run_gemini_advisor() {
  local repo_path="$1"
  local prompt="$2"
  local stdout_file="$3"
  local stderr_file="$4"

  (
    cd "$repo_path"
    GEMINI_CLI_TRUST_WORKSPACE=true gemini \
      --skip-trust \
      --approval-mode plan \
      --prompt "$prompt"
  ) >"$stdout_file" 2>"$stderr_file"
}

run_advisors() {
  local repo_path="$1"
  local task_text="$2"
  local run_dir="$3"

  require_cmd claude
  require_cmd gemini

  local claude_prompt gemini_prompt
  claude_prompt="$(advisor_prompt claude "$repo_path" "$task_text")"
  gemini_prompt="$(advisor_prompt gemini "$repo_path" "$task_text")"

  run_claude_advisor "$repo_path" "$claude_prompt" "$run_dir/claude.out" "$run_dir/claude.err" &
  local claude_pid=$!
  run_gemini_advisor "$repo_path" "$gemini_prompt" "$run_dir/gemini.out" "$run_dir/gemini.err" &
  local gemini_pid=$!

  local claude_status=0
  local gemini_status=0
  wait "$claude_pid" || claude_status=$?
  wait "$gemini_pid" || gemini_status=$?

  write_advisor_markdown claude "$claude_status" "$run_dir/claude.out" "$run_dir/claude.err" "$run_dir/claude.md"
  write_advisor_markdown gemini "$gemini_status" "$run_dir/gemini.out" "$run_dir/gemini.err" "$run_dir/gemini.md"

  if [[ "$claude_status" -ne 0 || "$gemini_status" -ne 0 ]]; then
    return 1
  fi
}

codex_prompt() {
  local repo_path="$1"
  local task_text="$2"
  local run_dir="$3"

  cat <<EOF
You are the Codex executor in an oh-my-kamisama run.

Repository:
$repo_path

Task:
$task_text

Before implementation, read these advisor artifacts:
- $run_dir/claude.md
- $run_dir/gemini.md

Use the advisors as context, not authority. Preserve unrelated user changes.
Apply the divecode genie principle: when the wish is underspecified, do not
silently invent high-risk requirements. Make reversible progress, record open
questions, and keep the user-facing result coherent. Apply AI-DLC gates:
Inception before broad design, Construction with tests/verification, Operations
with handoff notes when shipping behavior changes. Spend context aggressively
when it improves correctness; token thrift is not the goal of this run.
Finish with a concise summary of changes and verification.
EOF
}

run_codex_executor() {
  local repo_path="$1"
  local prompt="$2"
  local run_dir="$3"

  require_cmd codex
  (
    cd "$repo_path"
    codex exec \
      --skip-git-repo-check \
      -C "$repo_path" \
      -s workspace-write \
      "$prompt"
  ) >"$run_dir/codex.out" 2>"$run_dir/codex.err"
}

direct_executor_prompt() {
  local provider="$1"
  local repo_path="$2"
  local task_text="$3"

  cat <<EOF
You are the $provider executor in an oh-my-kamisama auto-routed run.

Repository:
$repo_path

Task:
$task_text

Inspect the repository before editing. Preserve unrelated user changes. Make the
narrowest useful change, run focused verification when possible, and finish with
a concise summary of changes, verification, and any remaining risks.
EOF
}

run_claude_executor() {
  local repo_path="$1"
  local prompt="$2"
  local run_dir="$3"

  require_cmd claude
  (
    cd "$repo_path"
    claude --print --permission-mode acceptEdits "$prompt"
  ) >"$run_dir/claude-exec.out" 2>"$run_dir/claude-exec.err"
}

run_gemini_executor() {
  local repo_path="$1"
  local prompt="$2"
  local run_dir="$3"

  require_cmd gemini
  (
    cd "$repo_path"
    GEMINI_CLI_TRUST_WORKSPACE=true gemini \
      --skip-trust \
      --approval-mode auto_edit \
      --prompt "$prompt"
  ) >"$run_dir/gemini-exec.out" 2>"$run_dir/gemini-exec.err"
}

write_run_summary() {
  local mode="$1"
  local repo_path="$2"
  local task_text="$3"
  local run_dir="$4"

  {
    echo "# oh-my-kamisama run"
    echo
    echo "- Mode: $mode"
    echo "- Repository: $repo_path"
    echo "- Created: $(now_utc)"
    echo
    echo "## Task"
    echo
    printf '%s\n' "$task_text"
    echo
    echo "## Artifacts"
    echo
    echo "- Claude: $run_dir/claude.md"
    echo "- Gemini: $run_dir/gemini.md"
    if [[ -f "$run_dir/codex.out" || -f "$run_dir/codex.err" ]]; then
      echo "- Codex stdout: $run_dir/codex.out"
      echo "- Codex stderr: $run_dir/codex.err"
    fi
    if [[ -f "$run_dir/claude-exec.out" || -f "$run_dir/claude-exec.err" ]]; then
      echo "- Claude executor stdout: $run_dir/claude-exec.out"
      echo "- Claude executor stderr: $run_dir/claude-exec.err"
    fi
    if [[ -f "$run_dir/gemini-exec.out" || -f "$run_dir/gemini-exec.err" ]]; then
      echo "- Gemini executor stdout: $run_dir/gemini-exec.out"
      echo "- Gemini executor stderr: $run_dir/gemini-exec.err"
    fi
  } >"$run_dir/RUN.md"
}

run_direct_executor() {
  local provider="$1"
  shift
  parse_repo_and_task "$@"

  local run_dir prompt status=0 stdout_file stderr_file
  run_dir="$(prepare_run_dir "$repo" "$task")"
  prompt="$(direct_executor_prompt "$provider" "$repo" "$task")"
  printf '%s\n' "$prompt" >"$run_dir/$provider.prompt.md"

  echo "omk run dir: $run_dir"
  echo "running executor: $provider"

  case "$provider" in
    codex)
      run_codex_executor "$repo" "$prompt" "$run_dir" || status=$?
      stdout_file="$run_dir/codex.out"
      stderr_file="$run_dir/codex.err"
      ;;
    claude)
      run_claude_executor "$repo" "$prompt" "$run_dir" || status=$?
      stdout_file="$run_dir/claude-exec.out"
      stderr_file="$run_dir/claude-exec.err"
      ;;
    gemini)
      run_gemini_executor "$repo" "$prompt" "$run_dir" || status=$?
      stdout_file="$run_dir/gemini-exec.out"
      stderr_file="$run_dir/gemini-exec.err"
      ;;
    *)
      die "unknown direct executor: $provider"
      ;;
  esac

  write_run_summary "$provider" "$repo" "$task" "$run_dir"

  if [[ -s "$stdout_file" ]]; then
    cat "$stdout_file"
  fi
  if [[ "$status" -ne 0 ]]; then
    echo "$provider failed; stderr: $stderr_file" >&2
    return "$status"
  fi

  echo "omk artifacts: $run_dir"
}

run_pipeline() {
  local mode="$1"
  shift
  parse_repo_and_task "$@"

  local run_dir
  run_dir="$(prepare_run_dir "$repo" "$task")"

  echo "omk run dir: $run_dir"
  echo "running advisors: claude + gemini"

  local advisor_status=0
  run_advisors "$repo" "$task" "$run_dir" || advisor_status=$?

  write_run_summary "$mode" "$repo" "$task" "$run_dir"

  if [[ "$advisor_status" -ne 0 ]]; then
    echo "one or more advisors failed; see $run_dir" >&2
    if [[ "${OMK_KEEP_GOING:-0}" != "1" || "$mode" == "advise" ]]; then
      echo "advisor artifacts:"
      echo "  $run_dir/claude.md"
      echo "  $run_dir/gemini.md"
      return "$advisor_status"
    fi
  fi

  if [[ "$mode" == "advise" ]]; then
    echo "advisor artifacts:"
    echo "  $run_dir/claude.md"
    echo "  $run_dir/gemini.md"
    return 0
  fi

  local prompt
  prompt="$(codex_prompt "$repo" "$task" "$run_dir")"
  printf '%s\n' "$prompt" >"$run_dir/codex.prompt.md"

  echo "running executor: codex"
  local codex_status=0
  run_codex_executor "$repo" "$prompt" "$run_dir" || codex_status=$?
  write_run_summary "$mode" "$repo" "$task" "$run_dir"

  if [[ -s "$run_dir/codex.out" ]]; then
    cat "$run_dir/codex.out"
  fi
  if [[ "$codex_status" -ne 0 ]]; then
    echo "codex failed; stderr: $run_dir/codex.err" >&2
    return "$codex_status"
  fi

  echo "omk artifacts: $run_dir"
}

confirm_gemini_fallback() {
  if [[ "${OMK_ALLOW_GEMINI_FALLBACK:-0}" == "1" ]]; then
    return 0
  fi
  if [[ -t 0 ]]; then
    local answer
    printf 'Codex/Claude를 사용할 수 없어 Gemini를 사용합니다. 진행할까요? [y/N] '
    IFS= read -r answer || return 1
    case "$answer" in
      y|Y|yes|YES|Yes|ㅇ|ㅇㅇ) return 0 ;;
      *) return 1 ;;
    esac
  fi
  echo "omk: Gemini fallback requires confirmation. Set OMK_ALLOW_GEMINI_FALLBACK=1 for non-interactive runs." >&2
  return 1
}

run_auto() {
  parse_repo_and_task "$@"
  ensure_agentcat_connectors || true

  local route
  route="$(agentcat_route_choice)"
  echo "omk auto route: $route"

  case "$route" in
    codex)
      run_direct_executor codex --repo "$repo" "$task"
      ;;
    claude)
      run_direct_executor claude --repo "$repo" "$task"
      ;;
    gemini)
      confirm_gemini_fallback || {
        echo "omk auto: cancelled Gemini fallback"
        return 2
      }
      run_direct_executor gemini --repo "$repo" "$task"
      ;;
    *)
      die "no usable agent found. Install/login to codex, claude, or gemini."
      ;;
  esac
}

bg_root_for_repo() {
  local repo_path="$1"
  echo "$repo_path/.omk/bg"
}

cockpit_root_for_repo() {
  local repo_path="$1"
  echo "$repo_path/.omk/cockpits"
}

resolve_job_dir() {
  local repo_path="$1"
  local token="${2:-latest}"
  local root
  root="$(bg_root_for_repo "$repo_path")"

  [[ -d "$root" ]] || die "no background jobs in $root"

  if [[ "$token" == "latest" ]]; then
    local latest
    latest="$(find "$root" -mindepth 1 -maxdepth 1 -type d | sort | tail -n 1)"
    [[ -n "$latest" ]] || die "no background jobs in $root"
    echo "$latest"
    return 0
  fi

  if [[ -d "$root/$token" ]]; then
    echo "$root/$token"
    return 0
  fi

  local matches
  matches="$(find "$root" -mindepth 1 -maxdepth 1 -type d -name "$token*" | sort || true)"
  local count
  count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"
  [[ "$count" -eq 1 ]] || die "job id '$token' matched $count jobs"
  printf '%s\n' "$matches"
}

job_id_from_dir() {
  basename "$1"
}

# Resolve a conductor run directory (one that has a session.json) for resume.
resolve_resume_dir() {
  local repo_path="$1"
  local token="${2:-latest}"
  local root="$repo_path/.omk/runs"
  [[ -d "$root" ]] || return 1

  if [[ "$token" != "latest" && -d "$root/$token" && -f "$root/$token/session.json" ]]; then
    echo "$root/$token"
    return 0
  fi

  local latest=""
  while IFS= read -r d; do
    [[ -f "$d/session.json" ]] && latest="$d"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -type d | sort)
  [[ -n "$latest" ]] || return 1
  echo "$latest"
}

# Run the conductor in-process (no exec) — used by the bash fallback shell.
run_conduct_inline() {
  local repo_path="$1"
  local task_text="$2"
  local conduct_js
  conduct_js="$(omk_script_dir)/omk-conduct.js"
  [[ -f "$conduct_js" ]] || { echo "conductor not found: $conduct_js" >&2; return 1; }
  require_cmd node
  node "$conduct_js" --repo "$repo_path" "$task_text"
}

# Resume the latest conductor run in-process (bash fallback shell).
resume_conduct_inline() {
  local repo_path="$1"
  local token="${2:-latest}"
  local conduct_js dir
  conduct_js="$(omk_script_dir)/omk-conduct.js"
  [[ -f "$conduct_js" ]] || { echo "conductor not found: $conduct_js" >&2; return 1; }
  require_cmd node
  dir="$(resolve_resume_dir "$repo_path" "$token")" || { echo "no resumable run found" >&2; return 1; }
  node "$conduct_js" --repo "$repo_path" --resume-dir "$dir"
}

bg_run() {
  parse_repo_and_task "$@"

  local root id job_dir self
  root="$(bg_root_for_repo "$repo")"
  id="$(now_utc)-$(slugify "$task")"
  job_dir="$root/$id"
  self="${BASH_SOURCE[0]}"

  mkdir -p "$job_dir"
  printf '%s\n' "$repo" >"$job_dir/repo.txt"
  printf '%s\n' "$task" >"$job_dir/task.txt"
  printf '%s\n' "running" >"$job_dir/status"
  now_utc >"$job_dir/started.txt"

  local self_q repo_q task_q job_dir_q
  self_q="$(printf '%q' "$self")"
  repo_q="$(printf '%q' "$repo")"
  task_q="$(printf '%q' "$task")"
  job_dir_q="$(printf '%q' "$job_dir")"

  cat >"$job_dir/run.sh" <<EOF
#!/usr/bin/env bash
set +e
kill_tree() {
  local p="\$1" child
  for child in \$(pgrep -P "\$p" 2>/dev/null); do kill_tree "\$child"; done
  kill "\$p" 2>/dev/null
}
finish_job() {
  code="\${1:-\$?}"
  if [[ ! -f $job_dir_q/exit_code ]]; then
    printf '%s\n' "\$code" >$job_dir_q/exit_code
    date -u '+%Y-%m-%dT%H-%M-%SZ' >$job_dir_q/finished.txt
    if [[ "\$code" -eq 0 ]]; then
      printf '%s\n' "done" >$job_dir_q/status
    else
      printf '%s\n' "failed" >$job_dir_q/status
    fi
  fi
}
# Run the pipeline in the background and wait, so a TERM/INT reaches us promptly
# (a foreground child would defer the trap) and we can tear down the whole tree.
$self_q run --repo $repo_q $task_q >$job_dir_q/stdout.log 2>$job_dir_q/stderr.log &
child=\$!
trap 'finish_job \$?' EXIT
trap 'kill_tree \$child; finish_job 143; exit 143' HUP INT TERM
wait "\$child"
code="\$?"
printf '%s\n' "\$code" >$job_dir_q/exit_code
date -u '+%Y-%m-%dT%H-%M-%SZ' >$job_dir_q/finished.txt
if [[ "\$code" -eq 0 ]]; then
  printf '%s\n' "done" >$job_dir_q/status
else
  printf '%s\n' "failed" >$job_dir_q/status
fi
sed -n 's/^omk artifacts: //p' $job_dir_q/stdout.log | tail -n 1 >$job_dir_q/run_dir.txt
trap - EXIT HUP INT TERM
exit "\$code"
EOF
  chmod +x "$job_dir/run.sh"

  nohup bash "$job_dir/run.sh" >"$job_dir/supervisor.log" 2>&1 &
  printf '%s\n' "$!" >"$job_dir/pid"

  echo "omk bg started"
  echo "id: $id"
  echo "pid: $(cat "$job_dir/pid")"
  echo "job: $job_dir"
  echo "logs: omk logs --repo '$repo' $id"
  echo "tail: omk tail --repo '$repo' $id"
}

ps_jobs() {
  parse_repo_only "$@"
  local root
  root="$(bg_root_for_repo "$repo")"
  if [[ ! -d "$root" ]]; then
    echo "no jobs"
    return 0
  fi

  printf '%-58s %-10s %-8s %s\n' "job" "status" "pid" "task"
  find "$root" -mindepth 1 -maxdepth 1 -type d | sort | while read -r job_dir; do
    local id status pid task
    id="$(job_id_from_dir "$job_dir")"
    status="$(cat "$job_dir/status" 2>/dev/null || echo unknown)"
    pid="$(cat "$job_dir/pid" 2>/dev/null || echo -)"
    task="$(cat "$job_dir/task.txt" 2>/dev/null | head -n 1 || true)"
    if [[ "$status" == "running" && "$pid" != "-" ]] && ! ps -p "$pid" >/dev/null 2>&1; then
      status="lost"
    fi
    printf '%-58s %-10s %-8s %s\n' "$id" "$status" "$pid" "$task"
  done
}

watch_jobs() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local interval="${OMK_WATCH_INTERVAL:-2}"

  while true; do
    clear 2>/dev/null || true
    echo "oh-my-kamisama watch"
    echo "===================="
    echo "repo: $repo"
    echo "time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo

    ps_jobs --repo "$repo" || true
    echo

    local job_dir=""
    if job_dir="$(resolve_job_dir "$repo" "$token" 2>/dev/null)"; then
      echo "# $(job_id_from_dir "$job_dir")"
      echo "status: $(cat "$job_dir/status" 2>/dev/null || echo unknown)"
      echo "pid: $(cat "$job_dir/pid" 2>/dev/null || echo -)"
      if [[ -s "$job_dir/run_dir.txt" ]]; then
        echo "run artifacts: $(cat "$job_dir/run_dir.txt")"
      fi
      echo
      echo "## stdout tail"
      if [[ -f "$job_dir/stdout.log" ]]; then
        tail -n 34 "$job_dir/stdout.log"
      else
        echo "(no stdout yet)"
      fi
      echo
      echo "## stderr tail"
      if [[ -f "$job_dir/stderr.log" ]]; then
        tail -n 18 "$job_dir/stderr.log"
      else
        echo "(no stderr yet)"
      fi
    else
      echo "no selected job yet: $token"
      echo "start one with: omk bg --repo $(quote_shell "$repo") \"task\""
    fi

    sleep "$interval"
  done
}

cockpit_launch() {
  parse_repo_and_task "$@"
  require_cmd cmux

  local root title slug cockpit_dir watch_script control_script
  root="$(cockpit_root_for_repo "$repo")"
  slug="$(slugify "$task")"
  [[ -n "$slug" ]] || slug="task"
  title="omk-${slug:0:34}"
  cockpit_dir="$root/$(now_utc)-$slug"
  watch_script="$cockpit_dir/watch.sh"
  control_script="$cockpit_dir/control.sh"

  mkdir -p "$cockpit_dir"
  printf '%s\n' "$repo" >"$cockpit_dir/repo.txt"
  printf '%s\n' "$task" >"$cockpit_dir/task.txt"

  local repo_q cockpit_dir_q
  repo_q="$(quote_shell "$repo")"
  cockpit_dir_q="$(quote_shell "$cockpit_dir")"

  cat >"$watch_script" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd $repo_q
omk watch --repo $repo_q latest
EOF

  cat >"$control_script" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd $repo_q
echo "OH MY KAMISAMA"
echo "=============="
echo
cat $cockpit_dir_q/task.txt
echo
omk bg --repo $repo_q "\$(cat $cockpit_dir_q/task.txt)" | tee $cockpit_dir_q/bg-start.txt
sleep 1
omk tail --repo $repo_q latest
EOF

  chmod +x "$watch_script" "$control_script"

  local watch_cmd control_cmd layout output
  watch_cmd="bash $(quote_shell "$watch_script")"
  control_cmd="bash $(quote_shell "$control_script")"
  layout='{"direction":"horizontal","split":0.43,"children":[{"pane":{"surfaces":[{"type":"terminal","command":"'"$(json_escape "$watch_cmd")"'"}]}},{"pane":{"surfaces":[{"type":"terminal","command":"'"$(json_escape "$control_cmd")"'"}]}}]}'

  output="$(cmux new-workspace \
    --name "$title" \
    --description "Oh My Kamisama cockpit" \
    --cwd "$repo" \
    --layout "$layout" \
    --focus true)"

  echo "$output"
  echo "omk cockpit: $cockpit_dir"
  echo "watch: $watch_script"
  echo "control: $control_script"
}

logs_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local job_dir
  job_dir="$(resolve_job_dir "$repo" "$token")"
  echo "# $(job_id_from_dir "$job_dir")"
  echo
  echo "status: $(cat "$job_dir/status" 2>/dev/null || echo unknown)"
  echo "pid: $(cat "$job_dir/pid" 2>/dev/null || echo -)"
  echo "repo: $(cat "$job_dir/repo.txt" 2>/dev/null || echo -)"
  echo "task: $(cat "$job_dir/task.txt" 2>/dev/null || echo -)"
  echo
  echo "## stdout"
  cat "$job_dir/stdout.log" 2>/dev/null || true
  echo
  echo "## stderr"
  cat "$job_dir/stderr.log" 2>/dev/null || true
}

tail_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-latest}"
  local job_dir
  job_dir="$(resolve_job_dir "$repo" "$token")"
  echo "tailing $(job_id_from_dir "$job_dir")"
  touch "$job_dir/stdout.log" "$job_dir/stderr.log"
  tail -n 80 -f "$job_dir/stdout.log" "$job_dir/stderr.log"
}

# Kill a process and all of its descendants (portable: pgrep on macOS/Linux).
# The supervisor pid alone is not enough — the real claude/codex/gemini workers
# are grandchildren and would be orphaned by a plain `kill` of the supervisor.
kill_tree() {
  local p="$1"
  local sig="${2:-TERM}"
  local child
  for child in $(pgrep -P "$p" 2>/dev/null || true); do
    kill_tree "$child" "$sig"
  done
  kill "-$sig" "$p" 2>/dev/null || true
}

kill_job() {
  parse_repo_only "$@"
  local token="${extra_args[0]:-}"
  [[ -n "$token" ]] || die "missing job id"
  local job_dir pid
  job_dir="$(resolve_job_dir "$repo" "$token")"
  pid="$(cat "$job_dir/pid" 2>/dev/null || true)"
  [[ -n "$pid" ]] || die "job has no pid"
  kill_tree "$pid" TERM
  printf '%s\n' "killed" >"$job_dir/status"
  now_utc >"$job_dir/finished.txt"
  echo "killed $(job_id_from_dir "$job_dir") pid=$pid (and descendants)"
}

shell_help() {
  cat <<'EOF'
Oh My Kamisama interactive shell

Type a natural-language task and press Enter. The current mode decides how it runs.

Slash commands:
  /help                 Show this help
  /exit                 Leave the shell
  /repo [PATH]          Show or change target repository
  /mode [MODE]          Show or set default mode: auto, conduct, run, claude,
                        gemini, advise, bg, cockpit, cmux
  /agents               Refresh agent status, usage, and auto route
  /refresh              Redraw the launch screen
  /screen               Show the compact status panel
  /route                Show the current auto route
  /connect              Install/check Agent Cat Connectors
  /context              Show repo branch, scripts, surfaces, and route
  /diff                 Show git status and diff stats
  /cost                 Show Agent Cat usage/cost summary
  /tasks                List local .omk task queue
  /task TASK            Add a task to the local .omk task queue
  /done ID              Mark a task done
  /auto TASK            Auto-route a task by Agent Cat quota/availability
  /conduct TASK         Run the multi-agent conductor loop
  /resume [run|latest]  Resume a previous conductor run
  /run TASK             Run one task through Claude + Gemini + Codex
  /claude TASK          Run a direct Claude executor task
  /gemini TASK          Run a direct Gemini executor task
  /advise TASK          Ask advisors only
  /bg TASK              Start a background conductor job
  /cockpit TASK         Open a cmux cockpit for the task
  /ps                   List background jobs for the current repo
  /logs [JOB|latest]    Print job logs
  /tail [JOB|latest]    Follow job logs
  /watch [JOB|latest]   Watch job status and tails
  /kill JOB|latest      Stop a background job
  /tools                Show detected tools
  /status               Show omk and provider versions
  /doctor               Check required and optional CLIs
  /! COMMAND            Run a shell command in the current repo
  /clear                Clear the screen

Multiline input:
  In the Node TTY shell, Shift+Enter or Meta+Enter inserts a newline when
  your terminal sends it. Backslash+Enter always continues on the next line.
  Set OMK_READLINE_REPL=1 to use the simpler readline fallback.

Examples:
  fix the failing auth test and verify it
  /agents
  /mode cockpit
  build the admin audit view with tests
  /advise review the safest migration path before coding
  /context
  /task write a regression test
EOF
}

shell_run_task() {
  local mode="$1"
  local repo_path="$2"
  local task_text="$3"
  local status=0

  case "$mode" in
    auto)
      run_auto --repo "$repo_path" "$task_text" || status=$?
      ;;
    conduct)
      run_conduct_inline "$repo_path" "$task_text" || status=$?
      ;;
    run)
      run_pipeline run --repo "$repo_path" "$task_text" || status=$?
      ;;
    claude)
      run_direct_executor claude --repo "$repo_path" "$task_text" || status=$?
      ;;
    gemini)
      run_direct_executor gemini --repo "$repo_path" "$task_text" || status=$?
      ;;
    advise)
      run_pipeline advise --repo "$repo_path" "$task_text" || status=$?
      ;;
    bg)
      bg_run --repo "$repo_path" "$task_text" || status=$?
      ;;
    cockpit|cmux)
      cockpit_launch --repo "$repo_path" "$task_text" || status=$?
      ;;
    *)
      echo "unknown mode: $mode" >&2
      status=2
      ;;
  esac

  if [[ "$status" -ne 0 ]]; then
    echo "omk shell: task exited with status $status" >&2
  fi
  return 0
}

interactive_shell() {
  parse_repo_only "$@"

  local shell_repo="$repo"
  local shell_mode="${OMK_SHELL_MODE:-auto}"
  case "$shell_mode" in
    auto|conduct|run|claude|gemini|advise|bg|cockpit|cmux) ;;
    *) shell_mode="auto" ;;
  esac

  local script_dir node_repl
  script_dir="$(omk_script_dir || true)"
  node_repl="$script_dir/omk-repl.js"
  if [[ "${OMK_BASH_REPL:-0}" != "1" && -t 0 && -t 1 && -f "$node_repl" ]] && have_cmd node; then
    exec node "$node_repl" --repo "$shell_repo" --mode "$shell_mode"
  fi

  ensure_agentcat_connectors || true

  clear 2>/dev/null || true
  shell_banner "$shell_repo" "$shell_mode"
  echo

  local line trimmed cmd rest prompt_base glyph
  while true; do
    prompt_base="$(basename "$shell_repo")"
    glyph="$(shell_prompt_glyph)"
    printf '%s ' "$glyph"
    if ! IFS= read -r line; then
      echo
      break
    fi

    trimmed="$(trim "$line")"
    [[ -n "$trimmed" ]] || continue

    if [[ "$trimmed" == /* ]]; then
      cmd="${trimmed%%[[:space:]]*}"
      rest="$trimmed"
      if [[ "$rest" == "$cmd" ]]; then
        rest=""
      else
        rest="$(trim "${trimmed#"$cmd"}")"
      fi

      case "$cmd" in
        /help|'/?')
          shell_help
          ;;
        /exit|/quit)
          break
          ;;
        /repo)
          if [[ -z "$rest" ]]; then
            echo "$shell_repo"
          else
            local next_repo
            if next_repo="$(cd "$rest" && pwd)"; then
              shell_repo="$next_repo"
              clear 2>/dev/null || true
              shell_banner "$shell_repo" "$shell_mode"
            else
              echo "repo not found: $rest" >&2
            fi
          fi
          ;;
        /mode)
          if [[ -z "$rest" ]]; then
            echo "$shell_mode"
          else
            case "$rest" in
              auto|conduct|run|claude|gemini|advise|bg|cockpit|cmux)
                shell_mode="$rest"
                clear 2>/dev/null || true
                shell_banner "$shell_repo" "$shell_mode"
                ;;
              *)
                echo "unknown mode: $rest" >&2
                echo "valid modes: auto, conduct, run, claude, gemini, advise, bg, cockpit, cmux" >&2
                ;;
            esac
          fi
          ;;
        /agents)
          ensure_agentcat_connectors || true
          agentcat_status_table
          ;;
        /refresh|/home|/screen|/statusline)
          clear 2>/dev/null || true
          shell_banner "$shell_repo" "$shell_mode"
          ;;
        /route)
          ensure_agentcat_connectors || true
          echo "auto route: $(agentcat_route_choice)"
          ;;
        /connect)
          ensure_agentcat_connectors
          agentcat_status_table
          ;;
        /context)
          repo_context --repo "$shell_repo"
          ;;
        /diff)
          repo_diff --repo "$shell_repo"
          ;;
        /cost|/usage)
          ensure_agentcat_connectors || true
          agentcat_cost_report
          ;;
        /tasks)
          tasks_list --repo "$shell_repo"
          ;;
        /task)
          [[ -n "$rest" ]] || { echo "usage: /task TASK" >&2; continue; }
          task_command --repo "$shell_repo" add "$rest"
          ;;
        /done)
          [[ -n "$rest" ]] || { echo "usage: /done ID" >&2; continue; }
          task_command --repo "$shell_repo" done "$rest"
          ;;
        /auto)
          [[ -n "$rest" ]] || { echo "usage: /auto TASK" >&2; continue; }
          shell_run_task auto "$shell_repo" "$rest"
          ;;
        /conduct)
          [[ -n "$rest" ]] || { echo "usage: /conduct TASK" >&2; continue; }
          shell_run_task conduct "$shell_repo" "$rest"
          ;;
        /resume)
          resume_conduct_inline "$shell_repo" "${rest:-latest}" || true
          ;;
        /run)
          [[ -n "$rest" ]] || { echo "usage: /run TASK" >&2; continue; }
          shell_run_task run "$shell_repo" "$rest"
          ;;
        /claude)
          [[ -n "$rest" ]] || { echo "usage: /claude TASK" >&2; continue; }
          shell_run_task claude "$shell_repo" "$rest"
          ;;
        /gemini)
          [[ -n "$rest" ]] || { echo "usage: /gemini TASK" >&2; continue; }
          shell_run_task gemini "$shell_repo" "$rest"
          ;;
        /advise)
          [[ -n "$rest" ]] || { echo "usage: /advise TASK" >&2; continue; }
          shell_run_task advise "$shell_repo" "$rest"
          ;;
        /bg)
          [[ -n "$rest" ]] || { echo "usage: /bg TASK" >&2; continue; }
          shell_run_task bg "$shell_repo" "$rest"
          ;;
        /cockpit|/cmux)
          [[ -n "$rest" ]] || { echo "usage: /cockpit TASK" >&2; continue; }
          shell_run_task cockpit "$shell_repo" "$rest"
          ;;
        /ps)
          ps_jobs --repo "$shell_repo" || true
          ;;
        /logs)
          logs_job --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /tail)
          tail_job --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /watch)
          watch_jobs --repo "$shell_repo" "${rest:-latest}" || true
          ;;
        /kill)
          [[ -n "$rest" ]] || { echo "usage: /kill JOB|latest" >&2; continue; }
          kill_job --repo "$shell_repo" "$rest" || true
          ;;
        /tools)
          tools
          ;;
        /status)
          status
          ;;
        /doctor)
          doctor || true
          ;;
        /clear)
          clear 2>/dev/null || true
          shell_banner "$shell_repo" "$shell_mode"
          ;;
        /!)
          [[ -n "$rest" ]] || { echo "usage: /! COMMAND" >&2; continue; }
          (cd "$shell_repo" && bash -lc "$rest") || true
          ;;
        /!*)
          rest="$(trim "${trimmed#/!}")"
          [[ -n "$rest" ]] || { echo "usage: /! COMMAND" >&2; continue; }
          (cd "$shell_repo" && bash -lc "$rest") || true
          ;;
        *)
          echo "unknown command: $cmd" >&2
          echo "type /help for commands" >&2
          ;;
      esac
    else
      shell_run_task "$shell_mode" "$shell_repo" "$trimmed"
    fi
  done
}

main() {
  [[ $# -gt 0 ]] || {
    if [[ -t 0 && -t 1 ]]; then
      interactive_shell
    else
      usage
    fi
    exit 0
  }

  case "$1" in
    shell|repl|interactive)
      shift
      interactive_shell "$@"
      ;;
    auto)
      shift
      run_auto "$@"
      ;;
    conduct)
      shift
      parse_repo_and_task "$@"
      local conduct_js
      conduct_js="$(omk_script_dir)/omk-conduct.js"
      [[ -f "$conduct_js" ]] || die "conductor not found: $conduct_js"
      require_cmd node
      exec node "$conduct_js" --repo "$repo" "$task"
      ;;
    resume)
      shift
      parse_repo_only "$@"
      local conduct_js token dir
      conduct_js="$(omk_script_dir)/omk-conduct.js"
      [[ -f "$conduct_js" ]] || die "conductor not found: $conduct_js"
      require_cmd node
      token="${extra_args[0]:-latest}"
      dir="$(resolve_resume_dir "$repo" "$token")" || die "no resumable run found in $repo/.omk/runs (token: $token)"
      exec node "$conduct_js" --repo "$repo" --resume-dir "$dir"
      ;;
    _rundir)
      shift
      parse_repo_and_task "$@"
      prepare_run_dir "$repo" "$task"
      ;;
    run)
      shift
      run_pipeline run "$@"
      ;;
    claude)
      shift
      run_direct_executor claude "$@"
      ;;
    gemini)
      shift
      run_direct_executor gemini "$@"
      ;;
    advise)
      shift
      run_pipeline advise "$@"
      ;;
    bg)
      shift
      bg_run "$@"
      ;;
    cockpit|cmux)
      shift
      cockpit_launch "$@"
      ;;
    watch)
      shift
      watch_jobs "$@"
      ;;
    ps)
      shift
      ps_jobs "$@"
      ;;
    logs)
      shift
      logs_job "$@"
      ;;
    tail)
      shift
      tail_job "$@"
      ;;
    kill)
      shift
      kill_job "$@"
      ;;
    agents)
      shift
      ensure_agentcat_connectors || true
      agentcat_status_table "$@"
      ;;
    connect)
      shift
      ensure_agentcat_connectors
      agentcat_status_table "$@"
      ;;
    context)
      shift
      repo_context "$@"
      ;;
    diff)
      shift
      repo_diff "$@"
      ;;
    cost|usage)
      shift
      ensure_agentcat_connectors || true
      agentcat_cost_report "$@"
      ;;
    tasks)
      shift
      tasks_list "$@"
      ;;
    task)
      shift
      task_command "$@"
      ;;
    tools)
      shift
      tools "$@"
      ;;
    status)
      shift
      status "$@"
      ;;
    doctor)
      shift
      doctor "$@"
      ;;
    help|--help|-h)
      usage
      ;;
    --version|-v)
      echo "$VERSION"
      ;;
    *)
      run_auto "$@"
      ;;
  esac
}

main "$@"
